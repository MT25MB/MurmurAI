# Murmur AI backend configuration (all local — no cloud API keys)

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Alternative vision-capable model: llama3.2-vision or llava
OLLAMA_VISION_MODEL=llava
OLLAMA_REQUEST_TIMEOUT=120

# Whisper STT
WHISPER_MODEL=base.en          # base.en | small.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# VAD
VAD_BACKEND=webrtcvad           # webrtcvad | silero
VAD_SILENCE_MS=800
VAD_MODE=3

# Visual agent (SoM grounding + app shortcut knowledge)
OLLAMA_VISION_MODEL=qwen2.5-vl:7b
VISION_USE_SOM=1                # 1 = draw numbered boxes for exact clicking
VISION_USE_APP_KNOWLEDGE=1      # 1 = inject active app's shortcut cheat-sheet

# TTS
TTS_ENGINE=auto                # auto | kokoro | piper | pyttsx3
KOKORO_VOICE=af_heart
PIPER_MODEL=

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765

# First-run setup
MURMUR_AI_AUTO_DOWNLOAD_WEIGHTS=1   # 0 = skip whisper/kokoro weight download
